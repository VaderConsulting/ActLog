<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="My" GeneratedClassName="MySettings" UseMySettingsClassName="true">
  <Profiles />
  <Settings>
    <Setting Name="FilecopyInterval" Type="System.String" Scope="Application">
      <Value Profile="(Default)">15</Value>
    </Setting>
    <Setting Name="LogfileSourcePath" Type="System.String" Scope="Application">
      <Value Profile="(Default)">c:\data\ActivityLog</Value>
    </Setting>
    <Setting Name="WebServiceURL" Type="(Web Service URL)" Scope="Application">
      <Value Profile="(Default)">http://steam/WebService/service.asmx</Value>
    </Setting>
  </Settings>
</SettingsFile>