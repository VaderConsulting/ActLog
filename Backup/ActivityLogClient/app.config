<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="ActivityLogClient.My.MySettings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
        </sectionGroup>
        <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="ActivityLogClient.My.MySettings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <system.diagnostics>
        <sources>
            <!-- This section defines the logging configuration for My.Application.Log -->
            <source name="DefaultSource" switchName="DefaultSwitch">
                <listeners>
                    <add name="FileLog"/>
                    <!-- Uncomment the below section to write to the Application Event Log -->
                    <!--<add name="EventLog"/>-->
                </listeners>
            </source>
        </sources>
        <switches>
            <add name="DefaultSwitch" value="Information" />
        </switches>
        <sharedListeners>
            <add name="FileLog"
                 type="Microsoft.VisualBasic.Logging.FileLogTraceListener, Microsoft.VisualBasic, Version=8.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL"
                 initializeData="FileLogWriter"/>
            <!-- Uncomment the below section and replace APPLICATION_NAME with the name of your application to write to the Application Event Log -->
            <!--<add name="EventLog" type="System.Diagnostics.EventLogTraceListener" initializeData="APPLICATION_NAME"/> -->
        </sharedListeners>
    </system.diagnostics>
    <userSettings>
        <ActivityLogClient.My.MySettings>
            <setting name="PreferredServer" serializeAs="String">
                <value />
            </setting>
        </ActivityLogClient.My.MySettings>
    </userSettings>
    <applicationSettings>
        <ActivityLogClient.My.MySettings>
            <setting name="UseEventLog" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="MinimumDiskSpaceMbBeforeLogging" serializeAs="String">
                <value>10</value>
            </setting>
            <setting name="LogEvent552" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="ExcludedUserListSuccess" serializeAs="String">
                <value>SYSTEM;NETWORK SERVICE;LOCAL SERVICE;SVCSMS;IUSR_;SVCSQL</value>
            </setting>
            <setting name="PCSerialWMIQuery" serializeAs="String">
                <value>SELECT * FROM Win32_Bios</value>
            </setting>
            <setting name="PCSerialWMIProperty" serializeAs="String">
                <value>SerialNumber</value>
            </setting>
            <setting name="PCModelWMIQuery" serializeAs="String">
                <value>SELECT * FROM Win32_ComputerSystem</value>
            </setting>
            <setting name="PCModelWMIProperty" serializeAs="String">
                <value>Model</value>
            </setting>
            <setting name="LogEvent538Type3" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="LogEvent540Type3" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="PCManufacturerWMIProperty" serializeAs="String">
                <value>Manufacturer</value>
            </setting>
        </ActivityLogClient.My.MySettings>
    </applicationSettings>
</configuration>
